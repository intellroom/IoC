    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--4b8d1f27-6a93-4e50-b715-8c2f9d5a3e64",
      "created": "2026-08-27T00:00:00.000Z",
      "modified": "2026-08-27T00:00:00.000Z",
      "created_by_ref": "identity--6a1f9c37-2e84-4d51-b0a9-7c3e5f1d8b42",
      "abstract": "ADVERTENCIA: dominios legitimos suplantados - NO son IOCs",
      "content": "ilovepdf.com, smallpdf.com, pdfcandy.com y pdf2go.com NO son indicadores de compromiso: son los servicios legitimos suplantados por esta campana. ILOVEPDF, S.L. esta constituida en Barcelona, Espana, declara borrado de archivos a las dos horas y mantiene certificacion ISO/IEC 27001. Incorporarlos a una lista de bloqueo por reputacion de malware es un error de hecho. Existen razones solidas para restringirlos en un entorno corporativo, pero son de gobernanza de datos (encargado de tratamiento sin contrato y transferencia internacional sin mecanismo habilitante), no de malware. Los nombres adobe.zip y audiobit.exe corresponden a una muestra concreta y son arbitrarios: detectar por comportamiento, no por nombre de archivo.",
      "object_refs": [
        "campaign--b48e2d15-9f07-4a63-8c21-5d9a0e7b3f16",
        "indicator--0c7e3f81-4b29-4d56-9a13-6e8f2c5b7d40",
        "indicator--6b2d9a54-8f13-4e07-b628-3c5a1d7f9e26",
        "indicator--3f8c1b70-5d46-4a92-8e35-9b7d2f4c6a18",
        "indicator--8d4a2e69-1c75-4b38-9f04-5e2b8c6d3a71",
